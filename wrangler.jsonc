{
  "name": "lottewy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/g/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lottewy",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:5173",
    "MODE": "development",
    "JEV_MODE": "live",
    "JEV_MODEL": "jev-1.13.0",
    "RPC_URL": "https://rpc.testnet.arc.io",
    "ADMIN_ADDRESSES": "0x7ad78fc8097dfea5c12dbb503d6eb6e60f34b40b",
    "CONSUMER_ADDRESS": "0xc79366c5a906f8f644830747a6096e004c4d2297",
    "CONSUMER_CODE_HASH": "0xb84b25c6893351395167283fb37c2c7abbfed734a6e043967a6ae6d295373dc5",
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "env": {
    "testnet": {
      "name": "lottewy-testnet",
      "account_id": "d9fa81565ed7a49a6076dba363d09f10",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{"pattern":"testnet.lottewy.com","custom_domain":true}],
      "vars": {
        "APP_ORIGIN": "https://testnet.lottewy.com",
        "MODE": "production",
        "JEV_MODE": "live",
        "JEV_MODEL": "jev-1.13.0",
        "RPC_URL": "https://rpc.drpc.testnet.arc.io",
        "ADMIN_ADDRESSES": "0x7ad78fc8097dfea5c12dbb503d6eb6e60f34b40b",
        "CONSUMER_ADDRESS": "0xc79366c5a906f8f644830747a6096e004c4d2297",
        "CONSUMER_CODE_HASH": "0xb84b25c6893351395167283fb37c2c7abbfed734a6e043967a6ae6d295373dc5"
      },
      "d1_databases": [{"binding":"DB","database_name":"lottewy-testnet","database_id":"468b722b-641f-4f63-bc38-ae3811443e60","migrations_dir":"migrations"}],
      "triggers":{"crons":["* * * * *"]}
    }
  }
}
