{
  "name": "lottewy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "build:testnet": "node scripts/build-testnet.mjs",
    "deploy:testnet": "npm run build:testnet && wrangler deploy --env testnet",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "contracts:compile": "node scripts/compile.mjs",
    "test:e2e": "playwright test",
    "build:mainnet": "node scripts/build-mainnet.mjs",
    "deploy:mainnet": "npm run build:mainnet && wrangler deploy --env mainnet"
  },
  "dependencies": {
    "@2toad/profanity": "3.3.0",
    "@d20dao/vrf-sdk": "^0.4.0",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.103.1",
    "@wagmi/core": "^2.22.1",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.56.8",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "hardhat": "^3.17.0",
    "prettier": "^3.9.8",
    "solc": "0.8.28",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "overrides": {
    "ws": "^8.21.0",
    "tmp": "^0.2.6"
  }
}
